    <decisionTable id="DecisionTable_P_SIMOG" hitPolicy="COLLECT">
      <input id="appalto_P_SIMOG">
        <inputExpression id="LiteralExpression_appalto_P_SIMOG" typeRef="string">
          <text>appalto</text>
        </inputExpression>
      </input>
      <input id="lotti_P_SIMOG" biodi:width="272">
        <inputExpression id="LiteralExpression_lotti_P_SIMOG" typeRef="string">
          <text>lotti</text>
        </inputExpression>
      </input>
      <input id="stazioniAppaltanti_P_SIMOG" biodi:width="170">
        <inputExpression id="LiteralExpression_stazioniAppaltanti_P_SIMOG" typeRef="string">
          <text>stazioniAppaltanti</text>
        </inputExpression>
      </input>
      <output id="Errore_P_SIMOG" name="Errore" typeRef="string" biodi:width="269" />
      <rule id="DecisionRule_0jlnblw">
        <description>REG146: E' obbligatorio inserire almeno uno dei due campi tra codIstat e codNUTS</description>
        <inputEntry id="UnaryTests_1kb4vhs">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_02puwzt">
          <text>some lotto in lotti
satisfies ((lotto.codIstat = null or lotto.codIstat = "" ) and (lotto.datiBaseContratto = null or lotto.datiBaseContratto.codNUTS = null or lotto.datiBaseContratto.codNUTS = ""))</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0lq72ka">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0vjgl00">
          <text>"{\"idTipologica\":\"errori\",\"codice\":\"REG146\"}"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0i4efzv">
        <description>REG147: Inserire solo uno tra i campi codIstat e codNUTS</description>
        <inputEntry id="UnaryTests_0ye4tig">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_047snli">
          <text>some lotto in lotti
satisfies ((lotto.codIstat != null and lotto.codIstat != "" ) and (lotto.datiBaseContratto != null and lotto.datiBaseContratto.codNUTS != null and lotto.datiBaseContratto.codNUTS != ""))</text>
        </inputEntry>
        <inputEntry id="UnaryTests_12ifi0h">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0iux3l6">
          <text>"{\"idTipologica\":\"errori\",\"codice\":\"REG147\"}"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
