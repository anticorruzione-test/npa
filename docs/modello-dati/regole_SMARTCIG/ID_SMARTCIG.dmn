      <output id="Errore_ID_SMARTCIG" name="Errore" typeRef="string" biodi:width="477" />
      <rule id="DecisionRule_1hu4cce">
        <description>REG154: L'importo totale dei lotti non può superare i 40K</description>
        <inputEntry id="UnaryTests_0i7b4ko">
          <text>comunicazione.importo != null and comunicazione.importo &gt; 0</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1aq09ej">
          <text>nuovoImportoTotale &gt; 40000</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0l1veed">
          <text>"{\"idTipologica\":\"errori\",\"codice\":\"REG154\"}"</text>
        </outputEntry>
      </rule>
